{
  "name": "dsh-chat-time",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Prepends a local-time metadata tag to every user message before the agent processes it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dilses/dsh-chat-time.git"
  },
  "homepage": "https://github.com/Dilses/dsh-chat-time#readme",
  "bugs": {
    "url": "https://github.com/Dilses/dsh-chat-time/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "timestamp"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "INSTALL.md",
    "README.zh.md",
    "INSTALL.zh.md",
    "userscript/dsh-chat-time-hide.user.js"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
